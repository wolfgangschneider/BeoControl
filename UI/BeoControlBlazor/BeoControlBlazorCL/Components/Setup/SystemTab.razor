@using BeoControl.Interfaces
@using BeoControlBlazorServices
@using BeoControlBlazorCL.Pages
@using System.Reflection
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Sections
@inject DeviceService DeviceService
@inject UpdateService UpdateService
@implements IDisposable

<SectionContent SectionName="@SetupWindow.DisplayLine2">
    <span class="led led-red">APP @GetAppVersionDisplay().ToUpperInvariant()</span>
    <span class="led @(DeviceService.FirmwareVersion is null ? "led-off" : "led-red")">FW @(DeviceService.FirmwareVersion is { } fw ? $"V{fw.ToUpperInvariant()}" : "—")</span>
</SectionContent>

@if (_versions.Count > 0)
{
    <div class="bo-inline bo-row">
        <span class="bo-row-label">APP</span>
        <InputSelect class="bo-field" @bind-Value="_selectedVersion">
            @foreach (var v in _versions)
            {
                <option value="@v">v@(v)@(v == _installedVersion ? " (INSTALLED)" : "")</option>
            }
        </InputSelect>
        <button class="bo-field bo-compact" @onclick="InstallAsync" disabled="@(_installing || _selectedVersion == _installedVersion)">@(_installing ? "INSTALLING…" : "INSTALL")</button>
    </div>
    <p class="bo-hint">@(_installStatus ?? (UpdateService.AvailableVersion is { } available
                          ? $"UPDATE AVAILABLE: V{available.ToUpperInvariant()}"
                          : "INSTALLS THE SELECTED VERSION (ALSO OLDER) AND RESTARTS THE APP"))</p>
}
else
{
    <p class="bo-hint">APP: @_versionsStatus</p>
}

@* the firmware follows the app: only the image bundled with this app version (OTA, WiFi only) *@
<div class="bo-inline bo-row">
    <span class="bo-row-label">FIRMWARE</span>
    @* like APP: the bundled version (installable) plus the device's current version marked "(INSTALLED)" *@
    <select class="bo-field" @bind="_selectedFirmware" disabled="@(FirmwareVersions.Count == 0)">
        @if (FirmwareVersions.Count == 0)
        {
            <option value="">NO BUNDLED FIRMWARE</option>
        }
        @foreach (var v in FirmwareVersions)
        {
            <option value="@v">v@(v)@(v == DeviceService.FirmwareVersion ? " (INSTALLED)" : "")</option>
        }
    </select>
    <button class="bo-field bo-compact" @onclick="UpdateService.UpdateFirmwareAsync"
            disabled="@(!UpdateService.FirmwareUpdateAvailable || SelectedFirmware != UpdateService.AppVersion)">
        @(UpdateService.FirmwareProgress is { } p ? $"{p} %" : "INSTALL")
    </button>
</div>
@if (UpdateService.FirmwareStatus is { } status)
{
    <p class="bo-hint">@status.ToUpperInvariant()</p>
}
else
{
    <p class="bo-hint">FIRMWARE UPDATES ONLY OVER WIFI</p>
}

@code {
    private string? _selectedFirmware;

    // bundled image first (newest), then the version running on the device
    private List<string> FirmwareVersions =>
        new[] { UpdateService.BundledFirmwarePath is null ? null : UpdateService.AppVersion, DeviceService.FirmwareVersion }
            .OfType<string>().Distinct().ToList();

    private string? SelectedFirmware =>
        _selectedFirmware is { } s && FirmwareVersions.Contains(s) ? s : FirmwareVersions.FirstOrDefault();

    private List<string> _versions = [];
    private string _versionsStatus = "LOADING VERSIONS…";
    private string _selectedVersion = "";
    private readonly string? _installedVersion = UpdateService.AppVersion;   // same as the Velopack version in release builds
    private bool _installing;
    private string? _installStatus;

    protected override void OnInitialized()
    {
        UpdateService.Changed += OnChanged;
        DeviceService.OnStatusChanged += OnDeviceStatusChanged;
    }

    private async void OnChanged() => await InvokeAsync(StateHasChanged);
    private void OnDeviceStatusChanged(StatusMessage _) => OnChanged();

    public void Dispose()
    {
        UpdateService.Changed -= OnChanged;
        DeviceService.OnStatusChanged -= OnDeviceStatusChanged;
    }

    // opening the tab refreshes the list and the "UPDATE V…" display hint
    protected override async Task OnInitializedAsync()
    {
        await LoadVersionsAsync();
        await UpdateService.CheckForUpdateAsync();
    }

    private async Task InstallAsync()
    {
        _installing = true;
        _installStatus = null;
        try
        {
            await UpdateService.InstallVersionAsync(_selectedVersion);   // restarts the app on success
            _installStatus = $"V{_selectedVersion.ToUpperInvariant()} IS ALREADY INSTALLED";
        }
        catch (Exception ex)
        {
            _installStatus = $"INSTALL FAILED: {ex.Message}";
        }
        _installing = false;
    }

    private async Task LoadVersionsAsync()
    {
        try
        {
            _versions = await UpdateService.GetAvailableVersionsAsync();
            // newest version, also when it is the installed one (INSTALL is disabled then)
            _selectedVersion = _versions.FirstOrDefault() ?? "";
            _versionsStatus = "ONLY AVAILABLE IN INSTALLED RELEASE BUILDS";
        }
        catch (Exception ex)
        {
            _versionsStatus = $"VERSIONS NOT AVAILABLE: {ex.Message}";
        }
    }

    private static string GetAppVersionDisplay()
    {
        var entryAssembly = Assembly.GetEntryAssembly();
        var informationalVersion = entryAssembly?
            .GetCustomAttribute<AssemblyInformationalVersionAttribute>()?
            .InformationalVersion?
            .Split('+', 2)[0];

        var version = string.IsNullOrWhiteSpace(informationalVersion)
            ? entryAssembly?.GetName().Version?.ToString(3)
            : informationalVersion;

        if (string.IsNullOrWhiteSpace(version))
            return string.Empty;

        return $"v{version.TrimStart('v', 'V')}";
    }
}
