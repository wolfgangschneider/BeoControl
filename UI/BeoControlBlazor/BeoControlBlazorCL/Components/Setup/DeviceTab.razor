@using BeoControl.Interfaces
@using BeoControlBlazorServices
@using BeoControlBlazorCL.Pages
@using Microsoft.AspNetCore.Components.Sections
@inject DeviceService DeviceService
@implements IDisposable

<SectionContent SectionName="@SetupWindow.DisplayLine2">
    @foreach (var tab in Tabs)
    {
        <span class="led @(ActiveTab == tab ? "led-red" : "led-off")">@Label(tab)</span>
    }
    @if (!string.IsNullOrEmpty(ScanStatus))
    {
        <span class="led led-red">@ScanLedText()@if (IsScanning)
        {<span class="bo-dots"><span></span><span></span><span></span></span>}</span>
    }
</SectionContent>

<div class="bo-label">CONNECTION</div>
<div class="bo-keys bo-keys-4">
    @foreach (var tab in Tabs)
    {
        <button class="bo-key @(ActiveTab == tab ? "active" : "")" @onclick="() => SelectTab(tab)">@Label(tab)</button>
    }
</div>

<div class="bo-label">DEVICES</div>
@if (ActiveTab == DeviceType.USB)
{
    var usb = WithCurrent(SerialDevices, DeviceType.USB);
    @foreach (var d in usb)
    {
        <div class="bo-inline">
            <button class="bo-field @(SelectedSerial == d.Id ? "active" : "") @(IsCurrentId(DeviceType.USB, d.Id) ? "connected" : "")" @onclick="() => SelectedSerial = d.Id">@d.Id  @d.Name</button>
            <button class="bo-field bo-compact bo-conn" @onclick="() => Toggle(DeviceType.USB, d.Id, ConnectSerial)" disabled="@IsBusy">@ConnLabel(DeviceType.USB, d.Id)</button>
        </div>
    }
    @if (usb.Count == 0 && !IsScanning)
    {
        <p class="bo-hint">TAP USB TO DISCOVER USB DEVICES</p>
    }
}
@if (ActiveTab == DeviceType.BT)
{
    var ble = WithCurrent(BtDevices, DeviceType.BT);
    @foreach (var d in ble)
    {
        <div class="bo-inline">
            <button class="bo-field @(SelectedBt == d.Id ? "active" : "") @(IsCurrentId(DeviceType.BT, d.Id) ? "connected" : "")" @onclick="() => SelectedBt = d.Id">@(d.Name ?? "UNKNOWN")</button>
            <button class="bo-field bo-compact bo-conn" @onclick="() => Toggle(DeviceType.BT, d.Id, ConnectBluetooth)" disabled="@IsBusy">@ConnLabel(DeviceType.BT, d.Id)</button>
        </div>
    }
    @if (ble.Count == 0 && !IsScanning)
    {
        <p class="bo-hint">TAP BLE TO DISCOVER BLE DEVICES</p>
    }
}
@if (ActiveTab == DeviceType.PC2)
{
    @if (Pc2Available || IsPc2Connected)
    {
        <div class="bo-inline">
            <button class="bo-field active">PC2</button>
            <button class="bo-field bo-compact bo-conn" @onclick="TogglePc2" disabled="@IsBusy">@(IsPc2Connected ? "DISCONNECT" : "CONNECT")</button>
        </div>
    }
    @if (!IsPc2Connected)
    {
        <p class="bo-hint">CONNECT DIRECTLY VIA USB / MASTERLINK (PC2 CONTROLLER)</p>
    }
}
@if (ActiveTab == DeviceType.WIFI)
{
    var wifi = WithCurrent(WifiDevices, DeviceType.WIFI);
    @foreach (var d in wifi)
    {
        <div class="bo-inline">
            <button class="bo-field @(SelectedWifi == d.Id ? "active" : "")" @onclick="() => SelectedWifi = d.Id">@(d.Name ?? d.Id)</button>
            <button class="bo-field bo-compact bo-conn" @onclick="() => Toggle(DeviceType.WIFI, d.Id, ConnectWifi)" disabled="@IsBusy">@ConnLabel(DeviceType.WIFI, d.Id)</button>
        </div>
    }
    @if (wifi.Count == 0 && !IsScanning)
    {
        <p class="bo-hint">TAP WIFI TO DISCOVER WIFI DEVICES</p>
    }
}

@if (ActiveTab is DeviceType.USB or DeviceType.BT)
{
    @* credentials go over the USB/BLE link to the device connected via this tab (green row) *@
    var wifiTarget = IsConnectedVia(ActiveTab) ? DeviceService.CurrentDevice?.Name : null;
    <div class="bo-label">WIFI SETUP — @(wifiTarget ?? $"NO DEVICE CONNECTED VIA {Label(ActiveTab)}")</div>
    <div class="bo-inline">
        <input class="bo-field" @bind="WifiSsid" placeholder="SSID" disabled="@(wifiTarget is null)" />
        <span class="bo-pass">
            <input class="bo-field" type="@(ShowPass ? "text" : "password")" @bind="WifiPass" placeholder="PASSWORD" disabled="@(wifiTarget is null)" />
            <button type="button" class="bo-eye" @onclick="() => ShowPass = !ShowPass" title="@(ShowPass ? "Hide password" : "Show password")">@(ShowPass ? "🙈" : "👁")</button>
        </span>
        <button class="bo-field bo-compact" @onclick="StoreWifi" disabled="@(wifiTarget is null || string.IsNullOrWhiteSpace(WifiSsid))">STORE</button>
    </div>
    @if (wifiTarget is null)
    {
        <p class="bo-hint">CONNECT A DEVICE ABOVE TO STORE ITS WIFI SETTINGS</p>
    }
}

@code {
    private static readonly DeviceType[] Tabs = [DeviceType.USB, DeviceType.BT, DeviceType.PC2, DeviceType.WIFI];

    private DeviceType ActiveTab;
    private bool IsScanning;
    private bool IsBusy;
    private string? SelectedSerial;
    private string? SelectedBt;
    private string ScanStatus = "";
    private List<DeviceInfo> SerialDevices = [];
    private List<DeviceInfo> BtDevices = [];
    private CancellationTokenSource? _scanCts;
    private bool Pc2Available;
    private string? SelectedWifi;
    private List<DeviceInfo> WifiDevices = [];
    private string WifiSsid = "";
    private string WifiPass = "";
    private bool ShowPass;

    private bool IsPc2Connected =>
        DeviceService.IsConnected && DeviceService.CurrentDevice?.Type == DeviceType.PC2;

    /// <summary>Display label of a connection type (also used by the setup window's display line 1).</summary>
    public static string Label(DeviceType t) => t switch
    {
        DeviceType.USB => "USB",
        DeviceType.BT  => "BLE",
        DeviceType.PC2 => "PC2",
        DeviceType.WIFI => "WIFI",
        _              => t.ToString().ToUpperInvariant(),
    };

    protected override void OnInitialized()
    {
        DeviceService.OnStatusChanged += OnServiceStatusChanged;
        ActiveTab      = DeviceService.Settings.LastDevice;
        SelectedSerial = DeviceService.Settings.LastSerial?.Id;
        SelectedBt     = DeviceService.Settings.LastBluetooth?.Id;
        SelectedWifi   = DeviceService.Settings.LastWifi?.Id;
    }

    private async void OnServiceStatusChanged(StatusMessage msg) => await InvokeAsync(StateHasChanged);

    // Display text for scan progress: "SCANNING USB COM8", "SCANNING BLE"
    private string ScanLedText()
    {
        var s = ScanStatus.TrimStart('○', ' ').TrimEnd('.', '…', ' ');
        if (!IsScanning) return s.ToUpperInvariant();
        var what = ActiveTab == DeviceType.USB && s.StartsWith("Probing ") ? s["Probing ".Length..] : "";
        return $"SCANNING {Label(ActiveTab)} {what.ToUpperInvariant()}".TrimEnd();
    }

    private async Task SelectTab(DeviceType tab)
    {
        var stopOnly = tab == ActiveTab && IsScanning;
        ActiveTab = tab;
        _scanCts?.Cancel();
        IsScanning = false;
        ScanStatus = "";
        if (tab != DeviceType.PC2)
            Pc2Available = false;

        // no scan when only stopping, or when already connected via USB (open port can't be probed)
        if (stopOnly || (tab == DeviceType.USB && DeviceService.IsConnected && DeviceService.CurrentDevice?.Type == tab))
            return;
        await (tab switch { DeviceType.USB => ScanSerial(), DeviceType.BT => ScanBluetooth(), DeviceType.WIFI => ScanWifi(), _ => ScanPc2() });
    }

    private async Task ScanSerial()
    {
        _scanCts?.Cancel();
        var cts = _scanCts = new CancellationTokenSource();
        IsScanning = true;
        SerialDevices = [];
        ScanStatus = "Scanning…";
        StateHasChanged();
        try
        {
            SerialDevices = await DeviceService.ScanSerialAsync(
                s => { ScanStatus = s; InvokeAsync(StateHasChanged); },
                cts.Token);
            if (SerialDevices.Count > 0 && SelectedSerial is null)
                SelectedSerial = SerialDevices[0].Id;
            ScanStatus = $"Found {SerialDevices.Count} device(s).";
        }
        catch (OperationCanceledException) { if (cts == _scanCts) ScanStatus = "Scan cancelled."; }
        catch (Exception ex)               { ScanStatus = $"Error: {ex.Message}"; }
        finally { if (cts == _scanCts) { IsScanning = false; StateHasChanged(); } }
    }

    private async Task ScanBluetooth()
    {
        _scanCts?.Cancel();
        var cts = _scanCts = new CancellationTokenSource();
        IsScanning = true;
        BtDevices = [];
        ScanStatus = "Scanning…";
        StateHasChanged();
        try
        {
            BtDevices = await DeviceService.ScanBluetoothAsync(
                s => { ScanStatus = s; InvokeAsync(StateHasChanged); },
                cts.Token);
            if (BtDevices is [{ Id: { } singleDeviceId }] && !IsCurrentId(DeviceType.BT, singleDeviceId))
            {
                SelectedBt = singleDeviceId;
                ScanStatus = "Found 1 device. Connecting…";
                StateHasChanged();
                await ConnectBluetooth(SelectedBt);
                return;
            }

            if (BtDevices.Count > 0 && SelectedBt is null)
                SelectedBt = BtDevices[0].Id;
            ScanStatus = BtDevices.Count > 0
                ? $"Found {BtDevices.Count} device(s)."
                : GetBluetoothEmptyScanMessage();
        }
        catch (OperationCanceledException) { if (cts == _scanCts) ScanStatus = "Scan cancelled."; }
        catch (Exception ex)               { ScanStatus = $"Error: {ex.Message}"; }
        finally { if (cts == _scanCts) { IsScanning = false; StateHasChanged(); } }
    }

    private async Task ScanWifi()
    {
        _scanCts?.Cancel();
        var cts = _scanCts = new CancellationTokenSource();
        IsScanning = true;
        WifiDevices = [];
        ScanStatus = "Scanning…";
        StateHasChanged();
        try
        {
            WifiDevices = await DeviceService.ScanWifiAsync(
                s => { ScanStatus = s; InvokeAsync(StateHasChanged); },
                cts.Token);
            if (WifiDevices.Count > 0 && SelectedWifi is null)
                SelectedWifi = WifiDevices[0].Id;
            ScanStatus = $"Found {WifiDevices.Count} device(s).";
        }
        catch (OperationCanceledException) { if (cts == _scanCts) ScanStatus = "Scan cancelled."; }
        catch (Exception ex)               { ScanStatus = $"Error: {ex.Message}"; }
        finally { if (cts == _scanCts) { IsScanning = false; StateHasChanged(); } }
    }

    private async Task ScanPc2()
    {
        _scanCts?.Cancel();
        var cts = _scanCts = new CancellationTokenSource();
        IsScanning = true;
        Pc2Available = false;
        ScanStatus = "Scanning…";
        StateHasChanged();
        try
        {
            var found = await DeviceService.ScanPc2Async(
                s => { ScanStatus = s; InvokeAsync(StateHasChanged); },
                cts.Token);
            Pc2Available = found;
            ScanStatus = found ? "Found PC2 device." : "No PC2 device found.";
        }
        catch (OperationCanceledException) { if (cts == _scanCts) ScanStatus = "Scan cancelled."; }
        catch (Exception ex)               { ScanStatus = $"Error: {ex.Message}"; }
        finally { if (cts == _scanCts) { IsScanning = false; StateHasChanged(); } }
    }

    private async Task ConnectSerial(string? portName = null)
    {
        SelectedSerial = portName;
        IsBusy = true;
        StateHasChanged();
        await DeviceService.ConnectSerialAsync(portName);
        IsBusy = false;
        ScanStatus = DeviceService.IsConnected ? "" : "Connect failed.";
    }

    private async Task ConnectBluetooth(string? deviceId = null)
    {
        SelectedBt = deviceId;
        IsBusy = true;
        StateHasChanged();
        await DeviceService.ConnectBluetoothAsync(deviceId);
        IsBusy = false;
        ScanStatus = DeviceService.IsConnected ? "" : "Connect failed.";
    }

    private async Task ConnectPc2()
    {
        IsBusy = true;
        StateHasChanged();
        await DeviceService.ConnectPc2Async();
        IsBusy = false;
        Pc2Available = DeviceService.IsConnected && DeviceService.CurrentDevice?.Type == DeviceType.PC2;
        ScanStatus = DeviceService.IsConnected ? "" : "Connect failed.";
    }

    private async Task ConnectWifi(string? host)
    {
        if (host is null) return;
        SelectedWifi = host;
        IsBusy = true;
        StateHasChanged();
        await DeviceService.ConnectWifiAsync(host);
        IsBusy = false;
        ScanStatus = DeviceService.IsConnected ? "" : "Connect failed.";
    }

    private bool IsConnectedVia(DeviceType type) =>
        DeviceService.IsConnected && DeviceService.CurrentDevice?.Type == type;

    private bool IsCurrentId(DeviceType type, string? id) =>
        id is not null && IsConnectedVia(type) && DeviceService.CurrentDevice?.Id == id;

    // scan result plus the connected device (USB can't be re-probed while its port is open)
    private List<DeviceInfo> WithCurrent(List<DeviceInfo> scanned, DeviceType type) =>
        IsConnectedVia(type) && DeviceService.CurrentDevice is { } c && !scanned.Any(d => d.Id == c.Id)
            ? [c, .. scanned]
            : scanned;

    private void StoreWifi()
    {
        var ssid = WifiSsid.Trim();
        if (ssid.Contains(' '))
        {
            ScanStatus = "SSID with spaces not supported.";
            return;
        }
        DeviceService.SendCommand("wifi", $"{ssid} {WifiPass}");
        WifiPass = "";
        ScanStatus = "WiFi stored.";
    }

    private void Disconnect() => DeviceService.Disconnect();

    private string ConnLabel(DeviceType type, string? id) => IsCurrentId(type, id) ? "DISCONNECT" : "CONNECT";

    private async Task Toggle(DeviceType type, string? id, Func<string?, Task> connect)
    {
        if (IsCurrentId(type, id)) Disconnect();
        else await connect(id);
    }

    private async Task TogglePc2()
    {
        if (IsPc2Connected) Disconnect();
        else await ConnectPc2();
    }

    private static string GetBluetoothEmptyScanMessage()
    {
        if (!OperatingSystem.IsMacOS() && !OperatingSystem.IsMacCatalyst())
            return "Found 0 device(s).";

        return "No Bluetooth device selected. On macOS, Scan opens the Apple Bluetooth chooser. If it does not appear, check Bluetooth permission for the host app you launched this app from.";
    }

    public void Dispose()
    {
        DeviceService.OnStatusChanged -= OnServiceStatusChanged;
        _scanCts?.Cancel();
        _scanCts?.Dispose();
    }
}
