@using BeoControl.Interfaces
@using BeoControlBlazorServices
@using BeoControlBlazorCL.Pages
@using Microsoft.AspNetCore.Components.Sections
@inject DeviceService DeviceService
@inject UpdateService UpdateService
@implements IDisposable

<SectionContent SectionName="@SetupWindow.DisplayLine2">
    <span class="led @(DeviceService.FirmwareVersion is null ? "led-off" : "led-red")">@(DeviceService.FirmwareVersion is { } v ? $"FW V{v.ToUpperInvariant()}" : "NO FIRMWARE")</span>
    <span class="led @(UpdateService.FirmwareUpdateAvailable ? "led-green" : "led-off")">UPDATE V@(UpdateService.AppVersion.ToUpperInvariant())</span>
    <span class="led @(_scanning ? "led-green" : "led-off") bo-push">SEARCHING<span class="bo-dots"><span></span><span></span><span></span></span></span>
</SectionContent>

<div class="bo-label">INIT (USB)</div>
@if (UpdateService.FactoryImages.Count == 0)
{
    <p class="bo-hint">NO FACTORY IMAGES BUNDLED — ONLY AVAILABLE IN RELEASE BUILDS</p>
}
else
{
    <div class="bo-inline">
        @if (_ports.Length == 0 && !_scanning)
        {
            <div class="bo-field">NO PORTS FOUND</div>
        }
        else
        {
            <select class="bo-field" @bind="_port" disabled="@_scanning">
                @foreach (var (port, caption) in _ports)
                {
                    <option value="@port">@caption</option>
                }
            </select>
        }
        <button class="bo-field bo-compact" @onclick="RefreshPortsAsync" disabled="@_scanning">REFRESH</button>
    </div>
    <div class="bo-inline">
        <select class="bo-field" @bind="_board">
            @foreach (var board in UpdateService.FactoryImages)
            {
                <option value="@board">@board.ToUpperInvariant()</option>
            }
        </select>
    </div>
    <div class="bo-inline">
        @* empty = board default; name A-Z 0-9 _ -, GND -1 = none *@
        <input class="bo-field" style="flex-grow: 2" type="text" maxlength="32" placeholder="NAME (A-Z 0-9 _ -)" title="Empty = board default" @bind="_name" />
        <input class="bo-field" type="number" placeholder="TX PIN" title="Empty = board default" @bind="_txPin" />
        <input class="bo-field" type="number" placeholder="GND PIN" title="Empty = board default, -1 = none" @bind="_gndPin" />
    </div>
    <div class="bo-keys bo-keys-3">
        <button class="bo-key" @onclick="InitAsync" disabled="@(string.IsNullOrEmpty(_port) || UpdateService.FirmwareProgress is not null)">
            @(UpdateService.FirmwareProgress is { } ip ? $"{ip} %" : "INIT")
        </button>
    </div>
    <p class="bo-hint">@(UpdateService.FirmwareStatus?.ToUpperInvariant() ?? $"OVERWRITES THE ESP32 COMPLETELY (ALSO WIFI SETTINGS) WITH V{UpdateService.AppVersion.ToUpperInvariant()}")</p>
}

@code {
    private (string Port, string Caption)[] _ports = [];
    private string _port = "";
    private string _board = "";
    private string? _name;
    private int? _txPin;
    private int? _gndPin;
    private bool _scanning;

    protected override void OnInitialized()
    {
        UpdateService.Changed += OnChanged;
        DeviceService.OnStatusChanged += OnDeviceStatusChanged;
        _board = UpdateService.FactoryImages.FirstOrDefault() ?? "";
        if (_board != "")
            _ = RefreshPortsAsync();    // no images on Android, where serial ports are not supported
    }

    // WMI query takes a moment: in the background, SCANNING in display line 2 meanwhile
    private async Task RefreshPortsAsync()
    {
        _scanning = true;
        StateHasChanged();
        try
        {
            // Windows: WMI captions without Bluetooth ports; elsewhere (no WMI) the plain port names
            var detailed = await Task.Run(Beo4Adapter.Transport.SerialTransport.ListPortsDetailed);
            _ports = detailed.Count > 0
                ? detailed.Where(kv => !kv.Value.PnpId.StartsWith("BTHENUM", StringComparison.OrdinalIgnoreCase))
                          .Select(kv => (kv.Key, kv.Value.Caption)).OrderBy(p => p.Key).ToArray()
                : System.IO.Ports.SerialPort.GetPortNames().Order().Select(p => (p, p)).ToArray();
            if (_ports.Any(p => p.Port == _port))
                return;
            // prefer an Espressif USB port (VID 303A), then a CP210x bridge
            _port = detailed.Where(kv => kv.Value.PnpId.Contains("VID_303A", StringComparison.OrdinalIgnoreCase)).Select(kv => kv.Key).FirstOrDefault()
                 ?? detailed.Where(kv => kv.Value.Caption.Contains("CP210", StringComparison.OrdinalIgnoreCase)).Select(kv => kv.Key).FirstOrDefault()
                 ?? _ports.Select(p => p.Port).FirstOrDefault() ?? "";
        }
        finally
        {
            _scanning = false;
            StateHasChanged();
        }
    }

    private Task InitAsync() => UpdateService.InitFirmwareAsync(_port, _board, _name, _txPin, _gndPin);

    private async void OnChanged() => await InvokeAsync(StateHasChanged);
    private void OnDeviceStatusChanged(StatusMessage _) => OnChanged();

    public void Dispose()
    {
        UpdateService.Changed -= OnChanged;
        DeviceService.OnStatusChanged -= OnDeviceStatusChanged;
    }
}
