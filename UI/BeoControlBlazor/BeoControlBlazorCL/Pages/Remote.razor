@page "/"
@using BeoControl.Interfaces
@using BeoControlBlazor.Services
@using BeoControlBlazorServices
@using BeoControlBlazorCL.Remotes
@using BeoControlBlazorCL.Components

@inject DeviceService DeviceService
@inject ISpotifyService LaunchSpotifyService
@inject NavigationManager Nav
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IDisposable


<PageTitle>B&amp;O Remote</PageTitle>

@* connection problems show inside the remote (Beo4 display, Beolink 1000 footer), no extra space *@
@{
    var status = RemoteStatus();
}
<div class="remote-shell"
     onmousedown="if (event.button === 0 && window.chrome?.webview && !event.target.closest('button,select,input')) window.chrome.webview.postMessage('beocontrol:drag')">

    @if (Selected == RemoteType.Beolink1000)
    {
        <Beolink1000 OnCommand="SendCommand" OnSetup="OpenSetup" DeviceStatus="@CurrentSourceDisplayText()" Status="@status" />
    }
    else
    {
        var song = Spotify.IsSourceSelected() ? Spotify.Song : string.Empty;
        var interpret = Spotify.IsSourceSelected() ? Spotify.Interpret : string.Empty;
        <Beo4 OnCommand="SendCommand" OnSetup="OpenSetup" DeviceStatus="@CurrentSourceDisplayText()" Status="@status" Song="@song" Info="@interpret" />
    }
    
    @* hidden: setup opens from the remote (Beo4: LIST to BC SETUP, GO; Beolink 1000: SHIFT, MENU), which clicks this button *@
    <button id="beo-setup" style="display:none;" title="Setup" onclick="window.chrome?.webview ? window.chrome.webview.postMessage('beocontrol:open-setup') : window.webkit?.messageHandlers?.beocontrol ? window.webkit.messageHandlers.beocontrol.postMessage('open-setup') : /Android|iPhone|iPad/.test(navigator.userAgent) ? Blazor.navigateTo('/setupwindow') : window.open('/setupwindow', 'beoSetup', `width=700,height=460,left=${screenX + outerWidth},top=${screenY}`)"></button>

</div>


@code {
    private const string SpotifyAddInName = "Spotify";
    private static readonly BeoCommand[] SourceCommands =
        BeoCommands.All.Where(command => command.Category == CommandCategory.Source).ToArray();

    private RemoteType Selected;
    private SourceStatusMessage? _sourceStatus;
    private BeoCommand? _currentSource;
    private SpotifyBridge Spotify =>  field ??= new(this);

    protected override void OnInitialized()
    {
        Selected = DeviceService.Settings.LastRemote;
        RemoteButton.Zoom = NormalizeZoom(DeviceService.Settings.RemoteButtonZoom);
        SyncSourceAddIns();
        DeviceService.OnStatusChanged += OnStatusChanged;
        DeviceService.Settings.Changed += OnSettingsChanged;
        Spotify.SubscribeNowPlayingChanged();
        _ = Spotify.EnsureConnectionStateAsync();
    }

    private async void OnStatusChanged(StatusMessage msg)
    {
        if (msg is SourceStatusMessage sourceStatus)
        {
            var sourceChanged = !string.Equals(_sourceStatus?.Command, sourceStatus.Command, StringComparison.Ordinal);
            _sourceStatus = sourceStatus;
            _currentSource = BeoCommands.Get(sourceStatus.Command) ?? _currentSource;

            if (sourceChanged)
            {
                if (DeviceService.Settings.SpotifyEnabled)
                {
                    if (Spotify.IsSourceSelected())
                        await Spotify.RefreshPlaybackAsync();
                    else
                        await Spotify.EnsureConnectionStateAsync();
                }
            }
        }

        SyncSourceAddIns();
        await InvokeAsync(StateHasChanged);
    }

    // Setup window changed zoom or remote type: reload
    private void OnSettingsChanged() => InvokeAsync(() => Nav.NavigateTo("/", true));

    // Windows (WebView2) only: report the outline of the remote, the host cuts the
    // borderless window to it ("beocontrol:shape:" + JSON, CSS px); re-reported on every size change
    private const string ShapeReporter = """
        (() => {
          if (window.__beoShape || !window.chrome?.webview) return;
          window.__beoShape = true;
          let pending = 0;
          const send = () => {
            pending = 0;
            const rects = [...document.querySelectorAll('.beo4, .bl1000')].map(e => {
              const r = e.getBoundingClientRect();
              return { x: r.left, y: r.top, w: r.width, h: r.height, r: parseFloat(getComputedStyle(e).borderTopLeftRadius) || 0 };
            }).filter(r => r.w > 0 && r.h > 0);
            window.chrome.webview.postMessage('beocontrol:shape:' + JSON.stringify({ dpr: devicePixelRatio, rects }));
          };
          const schedule = () => { if (!pending) pending = requestAnimationFrame(send); };
          new ResizeObserver(schedule).observe(document.body);
          new MutationObserver(schedule).observe(document.body, { childList: true, subtree: true });
          window.addEventListener('resize', schedule);
          schedule();
        })()
        """;

    protected override Task OnAfterRenderAsync(bool firstRender) =>
        firstRender ? JS.InvokeVoidAsync("eval", ShapeReporter).AsTask() : Task.CompletedTask;

    public void Dispose()
    {
        Spotify.UnsubscribeNowPlayingChanged();
        DeviceService.OnStatusChanged -= OnStatusChanged;
        DeviceService.Settings.Changed -= OnSettingsChanged;
    }

    // the hidden button knows how to open the setup on each host (WebView2, WebKitGTK, phone, browser)
    private Task OpenSetup() => JS.InvokeVoidAsync("eval", "document.getElementById('beo-setup').click()").AsTask();

    private async Task SendCommand(BeoCommand command)
    {
        var commandCaptured = await Spotify.HandleCommandAsync(command);
        if (!commandCaptured)
            DeviceService.SendCommand(MapPc2TriggerCommand(command).Cmd);
        await InvokeAsync(StateHasChanged);
    }

    private void SyncSourceAddIns()
    {
        foreach (var sourceCommand in SourceCommands)
            sourceCommand.AddIn = null;

        Spotify.ApplySourceAddIn();
        ApplyPc2SourceAddIn();
    }

    private void ApplyPc2SourceAddIn()
    {
        if (DeviceService.CurrentDevice?.Type != DeviceType.PC2)
            return;

        var triggerCommand = BeoCommands.Get(DeviceService.Settings.Pc2TriggerCommand);
        if (triggerCommand?.Category != CommandCategory.Source)
            return;

        triggerCommand.AddIn = "PC";
    }

    private BeoCommand MapPc2TriggerCommand(BeoCommand command)
    {
        if (DeviceService.CurrentDevice?.Type != DeviceType.PC2)
            return command;

        if (command.Category != CommandCategory.Source)
            return command;

        if (!string.Equals(command.Cmd, DeviceService.Settings.Pc2TriggerCommand, StringComparison.Ordinal))
            return command;

        return BeoCommands.Get(CommandId.Pc);
    }

    private string CurrentSourceDisplayText()
    {
        var command = _sourceStatus?.Command;
        var source = _currentSource?.DisplayLabel
            ?? (command is not null ? BeoCommands.Get(command)?.DisplayLabel : null)
            ?? command
            ?? string.Empty;
        return _sourceStatus?.Index is int index
            ? $"{source} {index}"
            : source;
    }

    private bool IsConnecting =>
        !DeviceService.IsConnected && DeviceService.Status is DeviceStatus.Connecting or DeviceStatus.Discovering;

    // device problem always, Spotify problem only while the Spotify source is selected; null = all fine
    private string? RemoteStatus() =>
        !DeviceService.IsConnected ? (IsConnecting ? "CONNECTING" : "DISCONNECTED")
        : Spotify.IsSourceSelected() && DeviceService.Settings.SpotifyEnabled && !Spotify.IsSpotifyConnected() ? "SPOTIFY DISCONNECTED"
        : null;

    private static int NormalizeZoom(int zoom) => zoom switch
    {
        100 or 150 or 200 => zoom,
        _ => 100
    };

}
