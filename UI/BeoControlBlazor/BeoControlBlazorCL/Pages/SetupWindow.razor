@page "/setupwindow"
@using BeoControl.Interfaces
@using BeoControlBlazorServices
@using BeoControlBlazorCL.Components.Setup
@using Microsoft.AspNetCore.Components.Sections
@inject DeviceService DeviceService
@implements IDisposable


<PageTitle>Setup</PageTitle>
<HeadContent>
    <style>body { width: auto; margin: 0; background: #2b2b2b; overflow: hidden; }</style>   @* app.css limits body to --body-width *@
</HeadContent>

<div class="bo-panel">

    @* ── LED display (MCP 5500) ── *@
    <div class="bo-display">
        @* line 1: general info for all menus *@
        <div class="bo-display-row">
            <span class="led @StatusLedClass">@StatusLedText</span>
            <span class="led led-red">@(DeviceService.IsConnected && DeviceService.CurrentDevice is { } info ? (info.Name ?? info.Id)?.ToUpperInvariant() : "NO DEVICE")</span>
            @if (DeviceService.IsConnected && DeviceService.CurrentDevice is { } connected)
            {
                <span class="led led-green">@DeviceTab.Label(connected.Type)</span>
            }
            <span class="led @(DeviceService.Settings.SpotifyEnabled ? "led-green" : "led-off") bo-push">SPOTIFY</span>
            <span class="led led-red">@_menu</span>
        </div>
        @* line 2: rendered by the selected tab - all options shown, red = selected, green = connected/on, dark = not selected *@
        <div class="bo-display-row">
            <SectionOutlet SectionName="@DisplayLine2" />
        </div>
    </div>

    @* ── Control panel (MCP 5500) ── *@
    <div class="bo-controls">
        @switch (_menu)
        {
            case "DEVICE":  <DeviceTab />  break;
            case "PC2":     <Pc2Tab />     break;
            case "REMOTE":  <RemoteTab />  break;
            case "SPOTIFY": <SpotifyTab /> break;
            case "SYSTEM":  <SystemTab />  break;
        }
    </div>

    @* ── Aluminium nameplate + menu strip (Beomaster 4500) ── *@
    <div class="bo-nameplate"><span>BEOCONTROL SETUP PANEL</span></div>
    <nav class="bo-menu">
        @foreach (var m in Menus)
        {
            <button class="bo-menu-item @(_menu == m ? "active" : "")" @onclick="() => _menu = m">
                @m
            </button>
        }
        <button class="bo-close" title="Close" aria-label="Close" onclick="window.close()"></button>
    </nav>

</div>

@code {
    /// <summary>Section name of display line 2; each tab fills it with SectionContent.</summary>
    public const string DisplayLine2 = "setup-display-line2";

    private static readonly string[] Menus = ["DEVICE", "PC2", "REMOTE", "SPOTIFY", "SYSTEM"];

    private string _menu = "DEVICE";
    private string StatusLedText =>
        DeviceService.IsConnected ? "CONNECTED"
        : DeviceService.Status is DeviceStatus.Connecting or DeviceStatus.Discovering ? "CONNECTING"
        : "DISCONNECTED";

    private string StatusLedClass =>
        DeviceService.IsConnected ? "led-green"
        : DeviceService.Status is DeviceStatus.Connecting or DeviceStatus.Discovering ? "led-yellow"
        : "led-red";

    protected override void OnInitialized()
    {
        DeviceService.OnStatusChanged += OnServiceStatusChanged;
    }

    private async void OnServiceStatusChanged(StatusMessage msg) => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        DeviceService.OnStatusChanged -= OnServiceStatusChanged;
    }
}
