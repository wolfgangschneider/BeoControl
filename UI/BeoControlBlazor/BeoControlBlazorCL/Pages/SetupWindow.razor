@page "/setupwindow"
@using BeoControl.Interfaces
@using BeoControlBlazorServices
@using BeoControlBlazorCL.Components.Setup
@using Microsoft.AspNetCore.Components.Sections
@inject DeviceService DeviceService
@inject UpdateService UpdateService
@implements IDisposable


<PageTitle>Setup</PageTitle>
<HeadContent>
    <style>body { width: auto; margin: 0; background: #2b2b2b; overflow: hidden; }</style>   @* app.css limits body to --body-width *@
</HeadContent>

<div class="bo-panel">

    @* ── LED display (MCP 5500) ── *@
    <div class="bo-display">
        @* line 1: general info for all menus *@
        <div class="bo-display-row">
            <span class="led @StatusLedClass">@StatusLedText@if (IsConnecting)
            {<span class="bo-dots"><span></span><span></span><span></span></span>}</span>
            @if ((DeviceService.IsConnected ? DeviceService.CurrentDevice : IsConnecting ? TargetDevice : null) is { } info)
            {
                <span class="led led-red">@((info.Name ?? info.Id)?.ToUpperInvariant())</span>
            }
            else if (!IsConnecting)
            {
                <span class="led led-red">NO DEVICE</span>
            }
            @if (DeviceService.IsConnected && DeviceService.CurrentDevice is { } connected)
            {
                <span class="led led-green">@DeviceTab.Label(connected.Type)</span>
            }
            @if (UpdateService.AvailableVersion is { } update)
            {
                <span class="led led-red bo-push">UPDATE V@(update.ToUpperInvariant())</span>
            }
            <span class="led @(DeviceService.Settings.SpotifyEnabled ? "led-green" : "led-off") @(UpdateService.AvailableVersion is null ? "bo-push" : "") bo-wide">SPOTIFY</span>
            <span class="led led-red bo-wide">@_menu</span>
        </div>
        @* line 2: rendered by the selected tab - all options shown, red = selected, green = connected/on, dark = not selected *@
        <div class="bo-display-row">
            <SectionOutlet SectionName="@DisplayLine2" />
        </div>
    </div>

    @* ── Control panel (MCP 5500) ── *@
    <div class="bo-controls">
        @switch (_menu)
        {
            case "DEVICE":  <DeviceTab />  break;
            case "PC2":     <Pc2Tab />     break;
            case "APP":     <RemoteTab />  break;
            case "SPOTIFY": <SpotifyTab /> break;
            case "FIRMWARE": <FirmwareTab /> break;
            case "UPDATE":  <SystemTab />  break;
        }
    </div>

    @* ── Aluminium nameplate + menu strip (Beomaster 4500) ── *@
    <div class="bo-nameplate"><span>BEOCONTROL SETUP PANEL</span></div>
    <nav class="bo-menu">
        @foreach (var m in Menus)
        {
            <button class="bo-menu-item @(_menu == m ? "active" : "")" @onclick="() => _menu = m">
                @m
            </button>
        }
        <button class="bo-close" title="Close" aria-label="Close" onclick="window.opener || window.chrome?.webview ? window.close() : history.back()"></button>
    </nav>

</div>

@code {
    /// <summary>Section name of display line 2; each tab fills it with SectionContent.</summary>
    public const string DisplayLine2 = "setup-display-line2";

    private static readonly string[] Menus = ["DEVICE", "PC2", "APP", "SPOTIFY", "FIRMWARE", "UPDATE"];

    private string _menu = "DEVICE";

    private bool IsConnecting =>
        !DeviceService.IsConnected && DeviceService.Status is DeviceStatus.Connecting or DeviceStatus.Discovering;

    // device being connected: not known to DeviceService yet, so take the last one used from the settings
    private DeviceInfo? TargetDevice => DeviceService.CurrentDevice ?? DeviceService.Settings.LastDevice switch
    {
        DeviceType.USB => DeviceService.Settings.LastSerial,
        DeviceType.BT  => DeviceService.Settings.LastBluetooth,
        DeviceType.WIFI => DeviceService.Settings.LastWifi,
        _              => null,
    };
    private string StatusLedText =>
        DeviceService.IsConnected ? "CONNECTED"
        : DeviceService.Status is DeviceStatus.Connecting or DeviceStatus.Discovering ? "CONNECTING"
        : "DISCONNECTED";

    private string StatusLedClass =>
        DeviceService.IsConnected ? "led-green"
        : DeviceService.Status is DeviceStatus.Connecting or DeviceStatus.Discovering ? "led-yellow"
        : "led-red";

    protected override void OnInitialized()
    {
        DeviceService.OnStatusChanged += OnServiceStatusChanged;
        UpdateService.Changed += OnUpdateChanged;
    }

    private async void OnServiceStatusChanged(StatusMessage msg) => await InvokeAsync(StateHasChanged);
    private async void OnUpdateChanged() => await InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        DeviceService.OnStatusChanged -= OnServiceStatusChanged;
        UpdateService.Changed -= OnUpdateChanged;
    }
}
