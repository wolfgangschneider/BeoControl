<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:BeoControlMaui"
             xmlns:components="clr-namespace:BeoControlMaui.Components"
             xmlns:web="clr-namespace:Microsoft.AspNetCore.Components.Web;assembly=Microsoft.AspNetCore.Components.Web"
             x:Class="BeoControlMaui.MainPage"
            BackgroundColor="Aqua"
             >
    <Grid RowDefinitions="*">

        <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/index.html"
                       BlazorWebViewInitialized="OnBlazorWebViewInitialized">
        <BlazorWebView.RootComponents>
            <RootComponent  Selector="#app" ComponentType="{x:Type components:Routes}" />
            <!-- HeadOutlet: /setupwindow opened in this view on phones lifts the body width via HeadContent -->
            <RootComponent  Selector="head::after" ComponentType="{x:Type web:HeadOutlet}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>
    </Grid>


</ContentPage>
